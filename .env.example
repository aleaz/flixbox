# Flixbox — copy to `.env` and adjust. Never commit `.env`.

# Project
COMPOSE_PROJECT_NAME=flixbox

# Which downloader stack to start (Compose profiles).
#   direct = qBittorrent on flixbox_net (no VPN)
#   vpn    = Gluetun + qBittorrent (added in a later phase)
COMPOSE_PROFILES=direct

# Dual-mode flag (CLI will align COMPOSE_PROFILES from this later)
VPN_ENABLED=false

# Host paths (use a single local filesystem for DATA_DIR — hardlinks)
DATA_DIR=/srv/flixbox/data
CONFIG_DIR=/srv/flixbox/config

# linuxserver-style ownership
PUID=1000
PGID=1000
UMASK=002
TZ=UTC

# qBittorrent (Direct mode publishes these on the host)
QBITTORRENT_PORT=8080
QBITTORRENT_BT_PORT=6881

# --- Gluetun (VPN mode; unused while COMPOSE_PROFILES=direct) ---
# VPN_SERVICE_PROVIDER=protonvpn
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# SERVER_COUNTRIES=
# VPN_PORT_FORWARDING=on
# BLOCK_IPV6=on
# DOT=on
