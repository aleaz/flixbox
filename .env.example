# Flixbox — copy to `.env` and adjust. Never commit `.env`.

COMPOSE_PROJECT_NAME=flixbox

# direct | vpn  (selects compose/downloaders-${FLIXBOX_MODE}.yml)
FLIXBOX_MODE=direct
VPN_ENABLED=false

DATA_DIR=/srv/flixbox/data
CONFIG_DIR=/srv/flixbox/config

PUID=1000
PGID=1000
UMASK=002
TZ=UTC

# Optional Compose profiles (comma-separated): plex, proxy, socket-proxy, recyclarr
# COMPOSE_PROFILES=

# --- Ports ---
QBITTORRENT_PORT=8080
QBITTORRENT_BT_PORT=6881
PROWLARR_PORT=9696
BYPARR_PORT=8191
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
JELLYFIN_PORT=8096
SEERR_PORT=5055
HOMEPAGE_PORT=3000
MAINTAINERR_PORT=6246
PLEX_PORT=32400
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- API keys (fill after first *arr login; used by Unpackerr/Decluttarr) ---
RADARR_API_KEY=
SONARR_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Decluttarr → qBittorrent URL (init sets this from FLIXBOX_MODE)
DECLUTTARR_QBIT_URL=http://qbittorrent:8080
DECLUTTARR_REMOVE_TIMER=10
DECLUTTARR_STRIKES=5
DECLUTTARR_MIN_SPEED=100

HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
JELLYFIN_PUBLISHED_URL=
SEERR_LOG_LEVEL=info
PLEX_CLAIM=

# --- Gluetun (FLIXBOX_MODE=vpn) ---
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# SERVER_COUNTRIES=
# OPENVPN_USER=
# OPENVPN_PASSWORD=
BLOCK_IPV6=on
DOT=on
VPN_PORT_FORWARDING=off
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24
