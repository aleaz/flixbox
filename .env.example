# Flixbox — copy to `.env` and adjust. Never commit `.env`.

# Project
COMPOSE_PROJECT_NAME=flixbox

# Downloader mode (selects which compose module is included):
#   direct = qBittorrent on flixbox_net (no VPN)
#   vpn    = Gluetun + qBittorrent (network_mode: service:gluetun)
FLIXBOX_MODE=direct

# Dual-mode flag (keep in sync with FLIXBOX_MODE; CLI will align both later)
VPN_ENABLED=false

# Host paths (use a single local filesystem for DATA_DIR — hardlinks)
DATA_DIR=/srv/flixbox/data
CONFIG_DIR=/srv/flixbox/config

# linuxserver-style ownership
PUID=1000
PGID=1000
UMASK=002
TZ=UTC

# qBittorrent WebUI / BitTorrent ports (published on host;
# in VPN mode these are bound on the Gluetun service)
QBITTORRENT_PORT=8080
QBITTORRENT_BT_PORT=6881

# --- Gluetun (required when FLIXBOX_MODE=vpn) ---
# See https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# Or mount a custom conf under ${CONFIG_DIR}/gluetun and set provider custom
# SERVER_COUNTRIES=Netherlands
# OPENVPN_USER=
# OPENVPN_PASSWORD=
BLOCK_IPV6=on
DOT=on
VPN_PORT_FORWARDING=off
# Optional: allow LAN subnets through Gluetun firewall if needed
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24
