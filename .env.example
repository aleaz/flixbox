# =============================================================================
# Flixbox — environment template (copy to .env; never commit .env)
# =============================================================================
#
# Quick start:
#   ./bin/flixbox init          # recommended: dirs, templates, mode alignment
#   ./bin/flixbox up
#
# Before first `up`, review [REQUIRED] below.
# Full reference: docs/user/06-configuration.md
# First-run UI wiring: docs/user/05-first-run.md
#
# =============================================================================

COMPOSE_PROJECT_NAME=flixbox

# -----------------------------------------------------------------------------
# [REQUIRED] Paths and download mode — edit before first up
# -----------------------------------------------------------------------------
#
# FLIXBOX_MODE selects which Compose downloader module is included:
#   direct — qBittorrent on the Docker bridge (default)
#   vpn    — qBittorrent shares Gluetun's network namespace
#
# DATA_DIR must be on a single local filesystem (hardlinks). Avoid NFS/SMB,
# exFAT, and WSL paths under /mnt/c (NTFS). See docs/07-operations-risks.md.
#
# CONFIG_DIR must be on local SSD/NVMe (not network storage).
#
# VPN_ENABLED is kept in sync with FLIXBOX_MODE by `flixbox init`.
# If you edit FLIXBOX_MODE by hand, set VPN_ENABLED to match (false/true).

FLIXBOX_MODE=direct
VPN_ENABLED=false

DATA_DIR=/srv/flixbox/data
CONFIG_DIR=/srv/flixbox/config

# -----------------------------------------------------------------------------
# [OPTIONAL] File ownership and timezone
# -----------------------------------------------------------------------------
#
# PUID/PGID: user that owns files in DATA_DIR and CONFIG_DIR (default 1000).
# UMASK=002: group-writable new files (shared across containers).
# TZ: IANA timezone, e.g. America/Argentina/Buenos_Aires or UTC.

PUID=1000
PGID=1000
UMASK=002
TZ=UTC

# -----------------------------------------------------------------------------
# [OPTIONAL] Compose profiles
# -----------------------------------------------------------------------------
#
# Enable optional services. Values: plex, proxy, socket-proxy, recyclarr
# (comma-separated). Alternative: ./bin/flixbox up plex proxy
#
# COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# [OPTIONAL] Host ports — change only if the default port is already in use
# -----------------------------------------------------------------------------
#
# Internal container ports stay fixed; these map host → container.

QBITTORRENT_PORT=8080
QBITTORRENT_BT_PORT=6881
PROWLARR_PORT=9696
BYPARR_PORT=8191
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
JELLYFIN_PORT=8096
SEERR_PORT=5055
HOMEPAGE_PORT=3000
MAINTAINERR_PORT=6246
PLEX_PORT=32400
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# [AFTER FIRST-RUN] API keys and download-client auth
# -----------------------------------------------------------------------------
#
# The stack starts without these. Unpackerr and Decluttarr need Radarr/Sonarr
# keys to work. Copy from each app: Settings → General → API Key.
# After editing, recreate affected containers: ./bin/flixbox up
#
# QBITTORRENT_USERNAME/PASSWORD: only if qBittorrent WebUI auth is enabled
# (Decluttarr needs them). Default linuxserver image often has no auth until
# you set one in the UI.

RADARR_API_KEY=
SONARR_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# -----------------------------------------------------------------------------
# [OPTIONAL] Decluttarr tuning
# -----------------------------------------------------------------------------
#
# DECLUTTARR_QBIT_URL: set automatically by `flixbox init` from FLIXBOX_MODE.
#   direct → http://qbittorrent:8080
#   vpn    → http://gluetun:8080
# Do not change unless you know the active download mode.
#
# REMOVE_TIMER: minutes between queue checks (default 10).
# STRIKES: permitted attempts before removal (default 5).
# MIN_SPEED: KiB/s threshold for "slow" removal (default 100).
# Protected qBit tag flixbox-keep is configured in compose (not here).

DECLUTTARR_QBIT_URL=http://qbittorrent:8080
DECLUTTARR_REMOVE_TIMER=10
DECLUTTARR_STRIKES=5
DECLUTTARR_MIN_SPEED=100

# -----------------------------------------------------------------------------
# [OPTIONAL] App-specific settings
# -----------------------------------------------------------------------------

# Homepage: add host:port if you access the dashboard by LAN IP or custom DNS.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Jellyfin: public URL when behind reverse proxy (profile proxy + Caddy).
JELLYFIN_PUBLISHED_URL=

# Seerr log level: error | warn | info | debug
SEERR_LOG_LEVEL=info

# Plex (profile plex): one-time claim from https://www.plex.tv/claim/
PLEX_CLAIM=

# -----------------------------------------------------------------------------
# [VPN ONLY] Gluetun — ignore this block when FLIXBOX_MODE=direct
# -----------------------------------------------------------------------------
#
# Set FLIXBOX_MODE=vpn, fill provider credentials, then:
#   ./bin/flixbox up
#   ./bin/flixbox vpn-test
#
# Provider list: https://github.com/qdm12/gluetun-wiki
#
# WireGuard: uncomment WIREGUARD_* (typical for Mullvad, Proton, etc.).
# OpenVPN: set VPN_TYPE=openvpn and OPENVPN_USER / OPENVPN_PASSWORD.
#
# Port forwarding (supported providers only): VPN_PORT_FORWARDING=on
# Also enable qBittorrent → Bypass authentication for clients on localhost.
#
# FIREWALL_OUTBOUND_SUBNETS: LAN CIDR so Gluetun allows access to your network
# (e.g. 192.168.1.0/24). Uncomment if containers cannot reach LAN hosts.

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# SERVER_COUNTRIES=
# SERVER_CITIES=
# SERVER_REGIONS=
# OPENVPN_USER=
# OPENVPN_PASSWORD=
BLOCK_IPV6=on
DOT=on
VPN_PORT_FORWARDING=off
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24
