# =============================================================================
# Flixbox — environment template (copy to .env; never commit .env)
# =============================================================================
#
# Quick start:
#   ./bin/flixbox init          # recommended: dirs, templates, mode alignment
#   ./bin/flixbox up
#   ./bin/flixbox configure     # after first login to each *arr app
#
# Before first `up`, review [REQUIRED] below.
# Full reference: docs/user/06-configuration.md
# First-run UI wiring: docs/user/05-first-run.md
#
# =============================================================================

COMPOSE_PROJECT_NAME=flixbox

# -----------------------------------------------------------------------------
# [REQUIRED] Paths and download mode — edit before first up
# -----------------------------------------------------------------------------
#
# FLIXBOX_MODE is the ONLY switch Compose uses for downloaders (exclusive):
#   direct — qBittorrent on the Docker bridge; Gluetun is NOT started
#   vpn    — Gluetun + qBittorrent in Gluetun's network namespace
# You cannot run Direct egress and Flixbox VPN for qBit at the same time.
#
# VPN_ENABLED is NOT read by Compose. It is a mirror for docs/CLI; `flixbox init`
# syncs it from FLIXBOX_MODE. Always set both together:
#   direct → VPN_ENABLED=false
#   vpn    → VPN_ENABLED=true
# Mismatch example: FLIXBOX_MODE=direct + VPN_ENABLED=true still runs Direct.
#
# To enable VPN: set FLIXBOX_MODE=vpn and VPN_ENABLED=true HERE, then fill
# [VPN ONLY] at the bottom. Do not only edit the Gluetun block.
#
# DATA_DIR must be on a single local filesystem (hardlinks). Avoid NFS/SMB,
# exFAT, and WSL paths under /mnt/c (NTFS). See docs/07-operations-risks.md.
#
# CONFIG_DIR must be on local SSD/NVMe (not network storage).
#
# Platform defaults (written by `flixbox init` into .env):
#   Linux:  /srv/flixbox/data   and /srv/flixbox/config
#   macOS:  $HOME/flixbox/data and $HOME/flixbox/config
# Values below are the Linux reference template; init adjusts per OS.

FLIXBOX_MODE=direct
VPN_ENABLED=false

DATA_DIR=/srv/flixbox/data
CONFIG_DIR=/srv/flixbox/config

# -----------------------------------------------------------------------------
# [OPTIONAL] File ownership and timezone
# -----------------------------------------------------------------------------
#
# PUID/PGID: user that owns files in DATA_DIR and CONFIG_DIR.
# Linux default: 1000. macOS: flixbox init sets id -u / id -g automatically.
# UMASK=002: group-writable new files (shared across containers).
# TZ: IANA timezone, e.g. America/Argentina/Buenos_Aires or UTC.

PUID=1000
PGID=1000
UMASK=002
TZ=UTC

# -----------------------------------------------------------------------------
# [OPTIONAL] Compose profiles
# -----------------------------------------------------------------------------
#
# Enable optional services. Values: plex, proxy, socket-proxy, recyclarr
# (comma-separated). Alternative: ./bin/flixbox up plex proxy
#
# COMPOSE_PROFILES=

# -----------------------------------------------------------------------------
# [OPTIONAL] Host ports — change only if the default port is already in use
# -----------------------------------------------------------------------------
#
# Internal container ports stay fixed; these map host → container.

QBITTORRENT_PORT=8080
QBITTORRENT_BT_PORT=6881
# Rewrite qBit save paths to /data/torrents on every start (default: false — only fixes missing/linuxserver /downloads paths)
# FLIXBOX_QBIT_FORCE_PATHS=false
PROWLARR_PORT=9696
BYPARR_PORT=8191
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
JELLYFIN_PORT=8096
SEERR_PORT=5055
HOMEPAGE_PORT=3000
MAINTAINERR_PORT=6246
PLEX_PORT=32400
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# [AFTER FIRST-RUN] API keys and download-client auth
# -----------------------------------------------------------------------------
#
# Four credential types — not interchangeable. See docs/user/06-configuration.md
# section "Credentials and API keys" and "App-to-app connections":
#
#   RADARR_API_KEY / SONARR_API_KEY  → Unpackerr, Decluttarr (.env)
#                                    → also Prowlarr Apps, Seerr, Bazarr, Maintainerr (each UI)
#   QBITTORRENT_USERNAME/PASSWORD    → Decluttarr only (qBit WebUI login; NOT qBit API key)
#                                    Leave empty on first up: Decluttarr stays idle (no qBit login spam).
#                                    After qBit WebUI password is set, fill these and recreate Decluttarr.
#   qBit API key                     → Radarr/Sonarr UI (Download Clients); not in .env
#   Jellyfin API key                 → Seerr, Maintainerr (Jellyfin UI); not in .env
#
# After editing, recreate affected containers: ./bin/flixbox up
# (plain "restart" keeps old env — use up / force-recreate)

RADARR_API_KEY=
SONARR_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# -----------------------------------------------------------------------------
# [OPTIONAL] Decluttarr tuning
# -----------------------------------------------------------------------------
#
# DECLUTTARR_QBIT_URL: always http://qbittorrent:8080 (VPN and Direct — ADR 0014).
# Do not change unless you know the active download mode.
#
# REMOVE_TIMER: minutes between queue checks (default 10).
# STRIKES: permitted attempts before removal (default 5).
# MIN_SPEED: KiB/s threshold for "slow" removal (default 100).
# Protected qBit tag flixbox-keep is configured in compose (not here).

DECLUTTARR_QBIT_URL=http://qbittorrent:8080
DECLUTTARR_REMOVE_TIMER=10
DECLUTTARR_STRIKES=5
DECLUTTARR_MIN_SPEED=100

# -----------------------------------------------------------------------------
# [OPTIONAL] App-specific settings
# -----------------------------------------------------------------------------

# Homepage: add host:port if you access the dashboard by LAN IP or custom DNS.
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Jellyfin: public URL when behind reverse proxy (profile proxy + Caddy).
JELLYFIN_PUBLISHED_URL=

# Seerr log level: error | warn | info | debug
SEERR_LOG_LEVEL=info

# Plex (profile plex): one-time claim from https://www.plex.tv/claim/
PLEX_CLAIM=

# -----------------------------------------------------------------------------
# [VPN ONLY] Gluetun — unused when FLIXBOX_MODE=direct (Gluetun is not started)
# -----------------------------------------------------------------------------
#
# Mode switch lives in [REQUIRED] at the top (Compose reads FLIXBOX_MODE only):
#   FLIXBOX_MODE=vpn
#   VPN_ENABLED=true   # mirror; alone does nothing
# Then: ./bin/flixbox init --non-interactive && docker compose down && ./bin/flixbox up
#       ./bin/flixbox vpn-test
# Also set Radarr/Sonarr download-client host to qbittorrent (port 8080) — same in both modes.
#
# Provider list: https://github.com/qdm12/gluetun-wiki
#
# Native providers (Proton, Mullvad, …): set VPN_SERVICE_PROVIDER to the Gluetun id.
#   WireGuard — uncomment WIREGUARD_* (typical).
#   OpenVPN   — VPN_TYPE=openvpn + OPENVPN_USER / OPENVPN_PASSWORD.
#
# Custom OpenVPN file (e.g. VPNGate .ovpn for lab tests — not for real privacy):
#   1. Place the file under ${CONFIG_DIR}/gluetun/ (volume is already mounted).
#   2. In the .ovpn, `remote` must be an IP address (not a hostname) — Gluetun requirement.
#   3. Set:
#        VPN_SERVICE_PROVIDER=custom
#        VPN_TYPE=openvpn
#        OPENVPN_CUSTOM_CONFIG=/gluetun/custom.conf   # path INSIDE the container
#        OPENVPN_USER=… / OPENVPN_PASSWORD=…          # if the .ovpn needs auth
#
# Port forwarding (supported commercial providers only): VPN_PORT_FORWARDING=on
# Also enable qBittorrent → Bypass authentication for clients on localhost.
# VPNGate / most free relays do NOT support port forwarding — leave off.
#
# FIREWALL_OUTBOUND_SUBNETS: LAN CIDR so host/LAN can reach qBit WebUI through Gluetun
# (e.g. 192.168.1.0/24). Uncomment if the WebUI is unreachable from your Mac/PC.

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# SERVER_COUNTRIES=
# SERVER_CITIES=
# SERVER_REGIONS=
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# OPENVPN_CUSTOM_CONFIG=/gluetun/custom.conf
BLOCK_IPV6=on
DOT=on
VPN_PORT_FORWARDING=off
# FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24
