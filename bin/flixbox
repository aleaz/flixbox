#!/usr/bin/env bash
# Flixbox CLI — day-0 / day-2 operations (MVP).
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/paths.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/env-file.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/flixbox-env.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/access-profile.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/preflight-host.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/qbit-webui-bootstrap.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/credentials.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/homepage-templates.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/cli-phase-a.sh"

NO_COLOR="${NO_COLOR:-}"
if [[ -t 1 && -z "${NO_COLOR}" ]]; then
  C_INFO='\033[34m'
  C_OK='\033[32m'
  C_WARN='\033[33m'
  C_ERR='\033[31m'
  C_RST='\033[0m'
else
  C_INFO=''; C_OK=''; C_WARN=''; C_ERR=''; C_RST=''
fi

log() { printf '%b%s%b\n' "${C_INFO}" "$*" "${C_RST}"; }
ok() { printf '%b%s%b\n' "${C_OK}" "$*" "${C_RST}"; }
warn() { printf '%b%s%b\n' "${C_WARN}" "$*" "${C_RST}" >&2; }
die() { printf '%b%s%b\n' "${C_ERR}" "$*" "${C_RST}" >&2; exit 1; }
die_usage() { printf '%b%s%b\n' "${C_ERR}" "$*" "${C_RST}" >&2; exit 2; }
die_docker() { printf '%b%s%b\n' "${C_ERR}" "$*" "${C_RST}" >&2; exit 3; }
die_config() { printf '%b%s%b\n' "${C_ERR}" "$*" "${C_RST}" >&2; exit 4; }

load_env() { flixbox_load_env; }

assert_docker_accessible() {
  if ! command -v docker >/dev/null 2>&1; then
    die_docker "Docker is not installed or not in PATH. See docs/user/03-requirements.md"
  fi
  if ! docker info >/dev/null 2>&1; then
    warn "Cannot connect to the Docker daemon at ${DOCKER_HOST:-unix:///var/run/docker.sock}."
    warn "Possible causes:"
    warn "  1. Docker service is not running ('sudo systemctl start docker')"
    warn "  2. Current user ($(id -un)) lacks permission ('sudo usermod -aG docker \$USER' then relogin)"
    warn "  3. Rootless Docker or Podman socket is not exported in DOCKER_HOST"
    warn "Troubleshooting: docs/user/10-troubleshooting.md#docker-daemon-access"
    die_docker "Docker daemon check failed."
  fi
}

compose() {
  assert_docker_accessible
  docker compose --project-directory "${ROOT_DIR}" "$@"
}

warn_unsafe_paths() {
  local path="$1"
  if [[ "${path}" == /mnt/c/* || "${path}" == /mnt/d/* ]]; then
    warn "Warning: ${path} looks like a Windows/WSL NTFS mount — hardlinks may fail."
  fi
  if [[ "${path}" == *exfat* ]]; then
    warn "Warning: path mentions exfat — hardlinks are unsupported."
  fi
}

# Compose reads FLIXBOX_MODE only; VPN_ENABLED is a mirror. Return 0 if aligned.
mode_vpn_aligned() {
  local mode="${FLIXBOX_MODE:-direct}"
  local vpn="${VPN_ENABLED:-false}"
  if [[ "${mode}" == "vpn" ]]; then
    [[ "${vpn}" == "true" ]]
  else
    [[ "${vpn}" == "false" ]]
  fi
}

warn_mode_vpn_mismatch() {
  mode_vpn_aligned && return 0
  local mode="${FLIXBOX_MODE:-direct}"
  local vpn="${VPN_ENABLED:-false}"
  local expected="false"
  [[ "${mode}" == "vpn" ]] && expected="true"
  warn "FLIXBOX_MODE=${mode} and VPN_ENABLED=${vpn} disagree (expected VPN_ENABLED=${expected})."
  warn "Compose follows FLIXBOX_MODE only — VPN_ENABLED does not start or stop Gluetun."
  warn "Fix: set VPN_ENABLED=${expected} in .env, or run: ./bin/flixbox init --non-interactive"
  return 1
}

# VPN + Decluttarr REMOVE_SLOW: absolute KiB/s floors remove slow-but-alive torrents.
warn_decluttarr_vpn_slow() {
  [[ "${FLIXBOX_MODE:-direct}" == "vpn" ]] || return 0
  local slow="${DECLUTTARR_REMOVE_SLOW:-False}"
  slow="$(printf '%s' "$slow" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  case "$slow" in
    true|1|yes|on) ;;
    *) return 0 ;;
  esac
  warn "VPN mode: DECLUTTARR_REMOVE_SLOW is enabled — slow VPN downloads can be removed after TIMER×STRIKES."
  warn "Flixbox default is REMOVE_SLOW=False. Prefer that, or tag important torrents flixbox-keep in qBit."
  warn "Docs: docs/user/08-hygiene.md · docs/09-hygiene-defaults.md"
  return 0
}

apply_platform_path_defaults() {
  apply_platform_env_defaults "${ROOT_DIR}/.env"
  if [[ "$(uname -s)" == Darwin ]]; then
    ok "Platform defaults in .env (paths under \$HOME/flixbox, PUID/PGID=$(id -u)/$(id -g))"
  else
    ok "Platform defaults in .env (DATA_DIR=$(flixbox_default_data_dir), CONFIG_DIR=$(flixbox_default_config_dir))"
  fi
}

# Servarr API keys (32 hex). Used by compose AUTH overrides + hygiene (ADR 0005).
generate_secret_hex() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16
  else
    python3 -c 'import secrets; print(secrets.token_hex(16))'
  fi
}

generate_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 18 | tr -d '/+=' | head -c 20
  else
    python3 -c 'import secrets; print(secrets.token_urlsafe(16)[:20])'
  fi
}

# Write KEY=value into .env only when missing or empty (never overwrite set secrets).
env_set_if_empty() {
  local key="$1" value="$2" env_file="${ROOT_DIR}/.env"
  local before after
  [[ -f "$env_file" ]] || return 0
  before="$(flixbox_env_file_get "$env_file" "$key")"
  [[ -n "$before" ]] && return 0
  flixbox_env_file_set_if_empty "$env_file" "$key" "$value" || return 1
  after="$(flixbox_env_file_get "$env_file" "$key")"
  [[ -n "$after" ]] && ok "Generated ${key} in .env (was empty)"
}

ensure_shared_ui_credentials() {
  if [[ "$(flixbox_access_profile)" != "shared" ]]; then
    return 0
  fi
  env_set_if_empty FLIXBOX_ARR_UI_USER admin
  env_set_if_empty FLIXBOX_ARR_UI_PASSWORD "$(generate_password)"
}

ensure_first_run_secrets() {
  local key
  for key in RADARR_API_KEY SONARR_API_KEY PROWLARR_API_KEY; do
    env_set_if_empty "$key" "$(generate_secret_hex)"
  done
  env_set_if_empty QBITTORRENT_USERNAME admin
  env_set_if_empty QBITTORRENT_PASSWORD "$(generate_password)"
  # Optional shared admin for Jellyfin/Seerr automation (configure)
  env_set_if_empty FLIXBOX_ADMIN_USER admin
  env_set_if_empty FLIXBOX_ADMIN_PASSWORD "$(generate_password)"
  ensure_shared_ui_credentials
}

copy_templates() {
  mkdir -p \
    "${CONFIG_DIR}/recyclarr" \
    "${CONFIG_DIR}/homepage" \
    "${CONFIG_DIR}/caddy" \
    "${CONFIG_DIR}/maintainerr" \
    "${CONFIG_DIR}/gluetun" \
    "${CONFIG_DIR}/qbittorrent" \
    "${CONFIG_DIR}/prowlarr" \
    "${CONFIG_DIR}/radarr" \
    "${CONFIG_DIR}/sonarr" \
    "${CONFIG_DIR}/bazarr" \
    "${CONFIG_DIR}/jellyfin" \
    "${CONFIG_DIR}/seerr" \
    "${CONFIG_DIR}/unpackerr"

  [[ -f "${CONFIG_DIR}/recyclarr/recyclarr.yml" ]] || \
    cp "${ROOT_DIR}/templates/recyclarr/recyclarr.yml" "${CONFIG_DIR}/recyclarr/recyclarr.yml"
  local homepage_services_created=0
  [[ -f "${CONFIG_DIR}/homepage/services.yaml" ]] || {
    cp "${ROOT_DIR}/templates/homepage/services.yaml" "${CONFIG_DIR}/homepage/services.yaml"
    homepage_services_created=1
  }
  python3 "${ROOT_DIR}/scripts/lib/homepage-sync.py" "${CONFIG_DIR}/homepage/services.yaml" >/dev/null 2>&1 || true
  [[ -f "${CONFIG_DIR}/homepage/settings.yaml" ]] || \
    cp "${ROOT_DIR}/templates/homepage/settings.yaml" "${CONFIG_DIR}/homepage/settings.yaml"
  [[ -f "${CONFIG_DIR}/homepage/widgets.yaml" ]] || \
    cp "${ROOT_DIR}/templates/homepage/widgets.yaml" "${CONFIG_DIR}/homepage/widgets.yaml"
  [[ -f "${CONFIG_DIR}/homepage/bookmarks.yaml" ]] || \
    cp "${ROOT_DIR}/templates/homepage/bookmarks.yaml" "${CONFIG_DIR}/homepage/bookmarks.yaml"
  [[ -f "${CONFIG_DIR}/homepage/custom.css" ]] || \
    cp "${ROOT_DIR}/templates/homepage/custom.css" "${CONFIG_DIR}/homepage/custom.css"
  [[ -f "${CONFIG_DIR}/homepage/custom.js" ]] || \
    cp "${ROOT_DIR}/templates/homepage/custom.js" "${CONFIG_DIR}/homepage/custom.js"
  mkdir -p "${CONFIG_DIR}/homepage/images"
  [[ -f "${CONFIG_DIR}/homepage/images/logo.png" ]] || \
    cp "${ROOT_DIR}/templates/homepage/images/logo.png" "${CONFIG_DIR}/homepage/images/logo.png"
  [[ -f "${CONFIG_DIR}/homepage/images/background.jpg" ]] || \
    cp "${ROOT_DIR}/templates/homepage/images/background.jpg" "${CONFIG_DIR}/homepage/images/background.jpg"
  # ADR 0022: Homepage must use socket-proxy host, never raw docker.sock.
  local homepage_docker="${CONFIG_DIR}/homepage/docker.yaml"
  local homepage_docker_need=0
  if [[ ! -f "${homepage_docker}" ]]; then
    homepage_docker_need=1
  elif grep -qE '^[[:space:]]*socket:' "${homepage_docker}" 2>/dev/null; then
    homepage_docker_need=1
  elif ! grep -qE 'host:[[:space:]]*docker-socket-proxy' "${homepage_docker}" 2>/dev/null; then
    homepage_docker_need=1
  fi
  if [[ "${homepage_docker_need}" -eq 1 ]]; then
    cp -f "${ROOT_DIR}/templates/homepage/docker.yaml" "${homepage_docker}"
    log "Homepage docker.yaml → docker-socket-proxy:2375 (ADR 0022)"
  fi
  # Stamp only on first create of services.yaml — never silence stale existing installs.
  if [[ "${homepage_services_created}" -eq 1 ]]; then
    flixbox_homepage_stamp_applied_from_template || true
  fi
  [[ -f "${CONFIG_DIR}/caddy/Caddyfile" ]] || \
    cp "${ROOT_DIR}/templates/caddy/Caddyfile" "${CONFIG_DIR}/caddy/Caddyfile"
  [[ -f "${CONFIG_DIR}/maintainerr/README.md" ]] || \
    cp "${ROOT_DIR}/templates/maintainerr/README.md" "${CONFIG_DIR}/maintainerr/README.md"
  cp -f "${ROOT_DIR}/templates/maintainerr/rule-pack.md" \
    "${CONFIG_DIR}/maintainerr/rule-pack.md"
  # linuxserver runs /custom-cont-init.d (separate mount), not /config/custom-cont-init.d
  mkdir -p "${CONFIG_DIR}/qbittorrent-cont-init" \
    "${CONFIG_DIR}/qbittorrent-custom-services" \
    "${CONFIG_DIR}/qbittorrent/.flixbox"
  cp -f "${ROOT_DIR}/templates/qbittorrent/custom-cont-init.d/99-flixbox-qbittorrent.sh" \
    "${CONFIG_DIR}/qbittorrent-cont-init/99-flixbox-qbittorrent.sh"
  chmod +x "${CONFIG_DIR}/qbittorrent-cont-init/99-flixbox-qbittorrent.sh"
  cp -f "${ROOT_DIR}/templates/qbittorrent/flixbox-qbit-api-login.sh" \
    "${CONFIG_DIR}/qbittorrent/.flixbox/qbit-api-login.sh"
  chmod 700 "${CONFIG_DIR}/qbittorrent/.flixbox/qbit-api-login.sh"
  cp -f "${ROOT_DIR}/templates/qbittorrent/webui-security-prefs.json" \
    "${CONFIG_DIR}/qbittorrent/.flixbox/webui-security-prefs.json"
  cp -f "${ROOT_DIR}/templates/qbittorrent/webui-security-prefs-portforward.json" \
    "${CONFIG_DIR}/qbittorrent/.flixbox/webui-security-prefs-portforward.json"
  rm -f "${CONFIG_DIR}/qbittorrent/.flixbox/session-temp-password"
  # WebUI contract reconciler — Direct + VPN (ADR 0019)
  cp -f "${ROOT_DIR}/templates/qbittorrent/custom-services.d/98-flixbox-webui-contract.sh" \
    "${CONFIG_DIR}/qbittorrent-custom-services/98-flixbox-webui-contract.sh"
  chmod +x "${CONFIG_DIR}/qbittorrent-custom-services/98-flixbox-webui-contract.sh"
  # tun0 bind — VPN only (ADR 0002); remove in Direct so the loop does not run
  if [[ "${FLIXBOX_MODE:-direct}" == "vpn" ]]; then
    cp -f "${ROOT_DIR}/templates/qbittorrent/custom-services.d/99-flixbox-bind-vpn-interface.sh" \
      "${CONFIG_DIR}/qbittorrent-custom-services/99-flixbox-bind-vpn-interface.sh"
    chmod +x "${CONFIG_DIR}/qbittorrent-custom-services/99-flixbox-bind-vpn-interface.sh"
  else
    rm -f "${CONFIG_DIR}/qbittorrent-custom-services/99-flixbox-bind-vpn-interface.sh"
  fi
  # Decluttarr idle-gate entrypoint (runtime env; not Compose-interpolated command)
  cp -f "${ROOT_DIR}/templates/decluttarr/entrypoint.sh" \
    "${CONFIG_DIR}/decluttarr-entrypoint.sh"
  chmod +x "${CONFIG_DIR}/decluttarr-entrypoint.sh"
  # Remove legacy location (ignored by current linuxserver images)
  rm -f "${CONFIG_DIR}/qbittorrent/custom-cont-init.d/99-flixbox-qbittorrent.sh" \
    "${CONFIG_DIR}/qbittorrent/custom-cont-init.d/99-flixbox-webui.sh"
  rmdir "${CONFIG_DIR}/qbittorrent/custom-cont-init.d" 2>/dev/null || true
}

cmd_init() {
  load_env
  local force=0 non_interactive=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --non-interactive) non_interactive=1; shift ;;
      *) die "Unknown init option: $1" ;;
    esac
  done

  if [[ -f "${ROOT_DIR}/.env" && "${force}" -ne 1 ]]; then
    warn ".env already exists (use --force to overwrite from .env.example)."
    flixbox_env_file_chmod "${ROOT_DIR}/.env"
  else
    cp -f "${ROOT_DIR}/.env.example" "${ROOT_DIR}/.env"
    chmod 600 "${ROOT_DIR}/.env"
    ok "Wrote .env from .env.example (mode 600)"
    apply_platform_path_defaults
  fi

  if [[ "${non_interactive}" -eq 0 ]]; then
    log "Edit .env now if needed (DATA_DIR, CONFIG_DIR, FLIXBOX_MODE, VPN_*)."
    log "Press Enter to continue with bootstrap dirs..."
    read -r _
  fi

  load_env
  warn_unsafe_paths "${DATA_DIR}"
  warn_unsafe_paths "${CONFIG_DIR}"

  if ! mode_vpn_aligned; then
    warn_mode_vpn_mismatch || true
    warn "Syncing VPN_ENABLED from FLIXBOX_MODE=${FLIXBOX_MODE}..."
  fi
  if [[ "${FLIXBOX_MODE}" == "vpn" ]]; then
    flixbox_env_file_set "${ROOT_DIR}/.env" VPN_ENABLED true
  else
    flixbox_env_file_set "${ROOT_DIR}/.env" VPN_ENABLED false
  fi
  load_env
  ok "VPN_ENABLED=${VPN_ENABLED} (aligned with FLIXBOX_MODE=${FLIXBOX_MODE})"

  # Decluttarr qBit URL — same host in VPN and Direct (ADR 0014: alias on Gluetun in VPN mode)
  flixbox_env_file_set "${ROOT_DIR}/.env" DECLUTTARR_QBIT_URL "http://qbittorrent:8080"

  # shellcheck disable=SC1091
  source "${ROOT_DIR}/scripts/lib/seerr-perms.sh"
  flixbox_prepare_paths_for_host_write || true

  validate_flixbox_paths "${DATA_DIR}" "${CONFIG_DIR}" || \
    die "Path validation failed. Fix DATA_DIR and CONFIG_DIR in .env, then re-run init."

  "${ROOT_DIR}/scripts/bootstrap-dirs.sh"
  load_env
  flixbox_prepare_paths_for_host_write || true
  copy_templates
  flixbox_validate_access_profile || die "Fix FLIXBOX_ACCESS_PROFILE in .env (trusted or shared)."
  flixbox_sync_access_profile_env "${ROOT_DIR}/.env"
  ensure_first_run_secrets
  load_env
  if ! flixbox_apply_runtime_ownership; then
    die "Runtime ownership failed (Seerr requires UID 1000 on ${CONFIG_DIR}/seerr). See docs/user/10-troubleshooting.md"
  fi
  ok "Init complete."
  log "Access profile: $(flixbox_access_profile) (*arr UI auth — ADR 0015)"
  if [[ "$(flixbox_access_profile)" == "shared" ]]; then
    log "shared: admin WebUIs bind to 127.0.0.1 (FLIXBOX_ADMIN_BIND_IP); open them on the host or via SSH tunnel."
    log "shared: after configure, apply Forms with: ./bin/flixbox credentials set arr-ui --generate   (or configure --sync-arr-ui)"
    log "shared: docs/user/13-access-profiles.md#create-arr-login-shared"
  fi
  log "Review .env before first up: DATA_DIR, CONFIG_DIR, FLIXBOX_MODE (Gluetun vars if vpn)."
  log "API keys + qBit/Jellyfin admin passwords were generated if empty — keep .env private."
  log "Show a secret: ./bin/flixbox credentials show qbit|admin|arr-ui"
  log "After up: ./bin/flixbox configure  (idempotent wiring; indexers stay manual)"
  log "Reference: docs/user/REFERENCE.md · First-run: docs/user/05-first-run.md"
}

ensure_access_profile() {
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/scripts/lib/configure-entry.sh"
  configure_entry_prepare
}

cmd_up() {
  assert_docker_accessible
  load_env
  ensure_access_profile
  local profiles=()
  parse_profiles profiles "$@"
  require_flixbox_dirs "${DATA_DIR}" "${CONFIG_DIR}" || \
    die "Directories missing. Run ./bin/flixbox init after fixing paths in .env."
  if [[ -z "${QBITTORRENT_PASSWORD:-}" || -z "${QBITTORRENT_USERNAME:-}" ]]; then
    warn "QBITTORRENT_USERNAME/PASSWORD incomplete — Decluttarr stays idle until both are set in .env and Decluttarr is recreated."
  fi
  if [[ "$(flixbox_access_profile)" == "trusted" && "${FLIXBOX_ADMIN_BIND_IP:-0.0.0.0}" == "0.0.0.0" ]]; then
    warn "trusted profile: admin UIs bind on all interfaces — use shared profile on untrusted LANs (docs/user/13-access-profiles.md)."
  fi
  if [[ -z "${FLIXBOX_PUBLIC_HOST:-}" ]]; then
    warn "Set FLIXBOX_PUBLIC_HOST (LAN IP/DNS) so Homepage Jellyfin/Seerr links work from phones/TVs — HOMEPAGE_ALLOWED_HOSTS and empty JELLYFIN_PUBLISHED_URL sync automatically (docs/user/13-access-profiles.md)."
  fi
  warn_mode_vpn_mismatch || true
  warn_decluttarr_vpn_slow || true
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/scripts/lib/seerr-perms.sh"
  # Refresh qBit custom-services for current FLIXBOX_MODE (ADR 0019 / 0002) before compose.
  # CONFIG only — never reclaim DATA_DIR while the stack may already be running.
  flixbox_prepare_config_for_host_write || true
  copy_templates
  flixbox_homepage_warn_if_stale || true
  flixbox_apply_config_runtime_ownership || \
    die "Config ownership failed (Seerr requires UID 1000 on ${CONFIG_DIR}/seerr). See docs/user/10-troubleshooting.md"
  warn_legacy_socket_proxy_profile || true
  flixbox_preflight_host_ports "${profiles[@]}"
  log "Starting Flixbox (FLIXBOX_MODE=${FLIXBOX_MODE})..."
  compose "${profiles[@]}" up -d --remove-orphans
  ok "Stack started. ./bin/flixbox status"
  if flixbox_qbit_webui_bootstrap; then
    # Decluttarr may have raced the temp-password window; recreate once auth is stable.
    if docker inspect flixbox-decluttarr >/dev/null 2>&1; then
      log "Recreating Decluttarr after qBit WebUI bootstrap..."
      compose up -d --force-recreate --no-deps decluttarr || \
        warn "Could not recreate Decluttarr — ./bin/flixbox reload or configure --sync-qbit-auth"
    fi
  else
    warn "qBit WebUI bootstrap did not finish — stack is up; run ./bin/flixbox configure --sync-qbit-auth when qBit accepts .env credentials"
  fi
  log "Next: ./bin/flixbox configure  (then add Prowlarr indexers)"
  log "After Direct↔VPN or qBit recreate: ./bin/flixbox configure --sync-qbit-auth"
  log "Guide: docs/user/05-first-run.md · Cheat sheet: docs/user/REFERENCE.md"
}

parse_profiles() {
  local -n _out=$1
  shift
  _out=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        if [[ "${2:-}" == "socket-proxy" ]]; then
          warn "socket-proxy profile is obsolete (ADR 0022): docker-socket-proxy always runs with Homepage."
          shift 2
        else
          _out+=(--profile "$2")
          shift 2
        fi
        ;;
      plex|proxy|recyclarr)
        _out+=(--profile "$1")
        shift
        ;;
      socket-proxy)
        warn "socket-proxy profile is obsolete (ADR 0022): docker-socket-proxy always runs with Homepage."
        shift
        ;;
      *)
        die "Unknown profile argument: $1 (try plex|proxy|recyclarr or --profile NAME)"
        ;;
    esac
  done
}

warn_legacy_socket_proxy_profile() {
  local compose_profiles="${COMPOSE_PROFILES:-}"
  local normalized=""
  [[ -n "$compose_profiles" ]] || return 0
  # Strip whitespace so "plex, socket-proxy" still matches.
  normalized="$(printf '%s' "$compose_profiles" | tr -d '[:space:]')"
  if [[ ",${normalized}," == *",socket-proxy,"* ]]; then
    warn "COMPOSE_PROFILES includes socket-proxy — remove it; proxy is always on with Homepage (ADR 0022)."
  fi
}

cmd_down() {
  load_env
  compose down "$@"
  ok "Stack stopped."
}

cmd_restart() {
  load_env
  local svc="${1:-}"
  [[ -n "${svc}" ]] || die "Usage: flixbox restart <service>"
  compose restart "${svc}"
}

cmd_reload() {
  assert_docker_accessible
  load_env
  ensure_access_profile
  local reset_homepage=0
  local profiles=()
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reset-homepage) reset_homepage=1; shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  parse_profiles profiles "${args[@]+"${args[@]}"}"
  require_flixbox_dirs "${DATA_DIR}" "${CONFIG_DIR}" || \
    die "Directories missing. Run ./bin/flixbox init first."
  if [[ -z "${FLIXBOX_PUBLIC_HOST:-}" ]]; then
    warn "Set FLIXBOX_PUBLIC_HOST (LAN IP/DNS) so Homepage Jellyfin/Seerr links work from phones/TVs — HOMEPAGE_ALLOWED_HOSTS and empty JELLYFIN_PUBLISHED_URL sync automatically (docs/user/13-access-profiles.md)."
  fi
  warn_mode_vpn_mismatch || true
  warn_decluttarr_vpn_slow || true
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/scripts/lib/seerr-perms.sh"
  flixbox_prepare_config_for_host_write || true
  copy_templates
  if [[ "$reset_homepage" -eq 1 ]]; then
    flixbox_homepage_refresh || die "Homepage refresh failed during reload --reset-homepage"
  else
    flixbox_homepage_warn_if_stale || true
  fi
  flixbox_apply_config_runtime_ownership || \
    die "Config ownership failed (Seerr requires UID 1000 on ${CONFIG_DIR}/seerr). See docs/user/10-troubleshooting.md"
  warn_legacy_socket_proxy_profile || true
  flixbox_preflight_host_ports "${profiles[@]}"
  log "Recreating containers (applies .env and compose changes)..."
  log "Tip: prefer reload over down when you only changed config."
  compose "${profiles[@]}" up -d --force-recreate --remove-orphans
  ok "Stack reloaded. ./bin/flixbox status"
  if flixbox_qbit_webui_bootstrap; then
    if docker inspect flixbox-decluttarr >/dev/null 2>&1; then
      log "Recreating Decluttarr after qBit WebUI bootstrap..."
      compose up -d --force-recreate --no-deps decluttarr || \
        warn "Could not recreate Decluttarr — configure --sync-qbit-auth"
    fi
  else
    warn "qBit WebUI bootstrap did not finish — stack reloaded; run ./bin/flixbox configure --sync-qbit-auth when qBit accepts .env credentials"
  fi
  log "If qBit auth or remapped-port WebUI broke: ./bin/flixbox configure --sync-qbit-auth"
}

cmd_homepage() {
  load_env
  local sub="${1:-}"
  [[ -n "$sub" ]] || die "Usage: flixbox homepage refresh [--dry-run]"
  shift || true
  case "$sub" in
    refresh)
      # shellcheck disable=SC1091
      source "${ROOT_DIR}/scripts/lib/seerr-perms.sh"
      flixbox_prepare_config_for_host_write || true
      flixbox_homepage_refresh "$@" || die "Homepage refresh failed"
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage:
  flixbox homepage refresh [--dry-run]

Overwrite managed Homepage config from templates/homepage (with backup),
sync ports/creds/chips, stamp applied revision, restart Homepage.
See docs/user/REFERENCE.md and docs/plans/homepage-template-refresh.md.
EOF
      ;;
    *)
      die "Unknown homepage subcommand: ${sub} (try: refresh)"
      ;;
  esac
}

cmd_configure() {
  assert_docker_accessible
  load_env
  exec "${ROOT_DIR}/scripts/configure-apps.sh" "$@"
}

cmd_status() {
  local json=0 quiet=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      -q|--quiet) quiet=1; shift ;;
      -h|--help)
        cat <<'EOF'
Usage: flixbox status [--json] [-q|--quiet]

Show Compose service status and operator context (mode, access profile, paths).

Options:
  --json          Machine-readable object on stdout (schemaVersion: 1)
  -q, --quiet     Suppress human info lines (warnings still on stderr)
  -h, --help      Show this help

Exit codes: 0 ok; 3 Docker unreachable; 2 usage error
EOF
        return 0
        ;;
      *) die_usage "status: unknown option: $1 (try --help)" ;;
    esac
  done

  if ! load_env 2>/dev/null; then
    if [[ "$json" -eq 1 ]]; then
      flixbox_emit_json '{"schemaVersion":1,"ok":false,"error":"env_load_failed"}'
    fi
    die_config "Failed to load .env — run ./bin/flixbox init first."
  fi

  if [[ "$json" -eq 1 ]]; then
    local docker_ok=false services_json="[]" err=""
    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
      docker_ok=true
      local compose_out=""
      if compose_out="$(docker compose --project-directory "${ROOT_DIR}" ps --format json 2>/dev/null)"; then
        services_json="$(printf '%s' "$compose_out" | python3 "${ROOT_DIR}/scripts/lib/compose-ps-json.py")" || services_json="[]"
      else
        err="compose_ps_failed"
      fi
    else
      err="docker_unreachable"
    fi
    local mode_aligned=true
    mode_vpn_aligned || mode_aligned=false
    local profile
    profile="$(flixbox_access_profile)"
    MODE_ALIGNED="$mode_aligned" DOCKER_OK="$docker_ok" PROFILE="$profile" \
      SERVICES_JSON="$services_json" ERR="$err" \
      FLIXBOX_MODE="${FLIXBOX_MODE:-direct}" VPN_ENABLED="${VPN_ENABLED:-false}" \
      FLIXBOX_ADMIN_BIND_IP="${FLIXBOX_ADMIN_BIND_IP:-}" \
      DATA_DIR="${DATA_DIR:-}" CONFIG_DIR="${CONFIG_DIR:-}" \
      CLI_VER="$(flixbox_cli_version)" \
      python3 "${ROOT_DIR}/scripts/lib/status-json.py"
    if [[ "$docker_ok" != true || -n "$err" ]]; then
      flixbox_exit_docker
    fi
    return 0
  fi

  if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    die_docker "Docker daemon check failed."
  fi
  compose ps
  if [[ "$quiet" -eq 0 ]]; then
    echo
    log "FLIXBOX_MODE=${FLIXBOX_MODE}  VPN_ENABLED=${VPN_ENABLED}"
  fi
  warn_mode_vpn_mismatch || true
  warn_decluttarr_vpn_slow || true
  if [[ "$quiet" -eq 0 ]]; then
    log "Access profile: $(flixbox_access_profile)  FLIXBOX_ADMIN_BIND_IP=${FLIXBOX_ADMIN_BIND_IP:-(unset)}"
    log "DATA_DIR=${DATA_DIR}"
    log "CONFIG_DIR=${CONFIG_DIR}"
    log "Download client URL for *arr / Decluttarr: http://qbittorrent:8080 (same in VPN and Direct — ADR 0014)"
  fi
  flixbox_homepage_warn_if_stale || true
}

cmd_version() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        cat <<'EOF'
Usage: flixbox version

Print CLI version identity (VERSION file or git describe). No secrets.
Also available as: flixbox --version
EOF
        return 0
        ;;
      *) die_usage "version: unknown option: $1" ;;
    esac
  done
  local ver project mode=""
  ver="$(flixbox_cli_version)"
  project="${COMPOSE_PROJECT_NAME:-flixbox}"
  if [[ -f "${ROOT_DIR}/.env" ]]; then
    load_env 2>/dev/null || true
    mode="${FLIXBOX_MODE:-}"
  fi
  printf 'flixbox %s\n' "$ver"
  printf 'project: %s\n' "$project"
  if [[ -n "$mode" ]]; then
    printf 'mode: %s\n' "$mode"
  fi
}

cmd_doctor() {
  local json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      -h|--help)
        cat <<'EOF'
Usage: flixbox doctor [--json]

Aggregate readiness checks for day-0 / day-2 operations.

Checks: Docker CLI/daemon, Compose plugin, .env, DATA_DIR/CONFIG_DIR,
FLIXBOX_MODE↔VPN_ENABLED alignment, access profile, API key presence (booleans),
Gluetun health when mode=vpn and the container exists.

Options:
  --json      Machine-readable report (schemaVersion: 1); no secret values
  -h, --help  Show this help

Exit codes: 0 all hard checks pass; 3 Docker; 4 config; 5 dependency not ready
EOF
        return 0
        ;;
      *) die_usage "doctor: unknown option: $1 (try --help)" ;;
    esac
  done

  local hard_fail=0 docker_fail=0 config_fail=0 deps_fail=0
  local docker_cli=false docker_daemon=false compose_plugin=false
  local env_file=false data_dir_ok=false config_dir_ok=false
  local mode_aligned=false profile_ok=false
  local radarr_key=false sonarr_key=false prowlarr_key=false
  local gluetun="skipped"
  local mode="unknown" profile="unknown" hint=""

  if command -v docker >/dev/null 2>&1; then
    docker_cli=true
  else
    hard_fail=1; docker_fail=1
    hint="Install Docker Engine + Compose v2 plugin."
  fi

  if [[ "$docker_cli" == true ]] && docker info >/dev/null 2>&1; then
    docker_daemon=true
  elif [[ "$docker_cli" == true ]]; then
    hard_fail=1; docker_fail=1
    hint="Start Docker or fix group permissions (docs/user/10-troubleshooting.md)."
  fi

  if [[ "$docker_daemon" == true ]] && docker compose version >/dev/null 2>&1; then
    compose_plugin=true
  elif [[ "$docker_daemon" == true ]]; then
    hard_fail=1; docker_fail=1
    hint="Install Docker Compose v2 plugin ('docker compose version')."
  fi

  if [[ -f "${ROOT_DIR}/.env" ]]; then
    env_file=true
    if load_env 2>/dev/null; then
      mode="${FLIXBOX_MODE:-direct}"
      profile="$(flixbox_access_profile)"
      if mode_vpn_aligned; then
        mode_aligned=true
      else
        config_fail=1; hard_fail=1
        hint="Align VPN_ENABLED with FLIXBOX_MODE in .env."
      fi
      if flixbox_validate_access_profile 2>/dev/null; then
        profile_ok=true
      else
        config_fail=1; hard_fail=1
        hint="Set FLIXBOX_ACCESS_PROFILE to trusted or shared."
      fi
      if [[ -n "${DATA_DIR:-}" && -d "${DATA_DIR}" ]]; then
        data_dir_ok=true
      else
        config_fail=1; hard_fail=1
        hint="DATA_DIR missing — run init or create ${DATA_DIR:-'(unset)'}."
      fi
      if [[ -n "${CONFIG_DIR:-}" && -d "${CONFIG_DIR}" ]]; then
        config_dir_ok=true
      else
        config_fail=1; hard_fail=1
        hint="CONFIG_DIR missing — run init or create ${CONFIG_DIR:-'(unset)'}."
      fi
      flixbox_secret_present "${RADARR_API_KEY:-}" && radarr_key=true
      flixbox_secret_present "${SONARR_API_KEY:-}" && sonarr_key=true
      flixbox_secret_present "${PROWLARR_API_KEY:-}" && prowlarr_key=true
      if [[ "$mode" == "vpn" && "$docker_daemon" == true ]]; then
        local st=""
        st="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' flixbox-gluetun 2>/dev/null || true)"
        if [[ -z "$st" ]]; then
          gluetun="not_running"
          deps_fail=1; hard_fail=1
          hint="FLIXBOX_MODE=vpn but flixbox-gluetun is not running — ./bin/flixbox up"
        elif [[ "$st" == "healthy" || "$st" == "running" ]]; then
          gluetun="ok"
        else
          gluetun="$st"
          deps_fail=1; hard_fail=1
          hint="Gluetun status is ${st} — check VPN credentials and ./bin/flixbox vpn-test"
        fi
      fi
    else
      config_fail=1; hard_fail=1
      hint="Failed to load .env"
    fi
  else
    config_fail=1; hard_fail=1
    hint="No .env — run ./bin/flixbox init"
  fi

  if [[ "$json" -eq 1 ]]; then
    DOCKER_CLI="$docker_cli" DOCKER_DAEMON="$docker_daemon" COMPOSE_PLUGIN="$compose_plugin" \
      ENV_FILE="$env_file" DATA_DIR_OK="$data_dir_ok" CONFIG_DIR_OK="$config_dir_ok" \
      MODE_ALIGNED="$mode_aligned" PROFILE_OK="$profile_ok" \
      RADARR_KEY="$radarr_key" SONARR_KEY="$sonarr_key" PROWLARR_KEY="$prowlarr_key" \
      GLUETUN="$gluetun" MODE="$mode" PROFILE="$profile" HINT="$hint" HARD_FAIL="$hard_fail" \
      CLI_VER="$(flixbox_cli_version)" \
      python3 "${ROOT_DIR}/scripts/lib/doctor-json.py"
  else
    log "flixbox doctor $(flixbox_cli_version)"
    [[ "$docker_cli" == true ]] && ok "Docker CLI" || warn "Docker CLI: missing"
    [[ "$docker_daemon" == true ]] && ok "Docker daemon" || warn "Docker daemon: unreachable"
    [[ "$compose_plugin" == true ]] && ok "Compose plugin" || warn "Compose plugin: missing"
    if [[ "$env_file" == true ]]; then
      ok ".env present"
      [[ "$data_dir_ok" == true ]] && ok "DATA_DIR" || warn "DATA_DIR missing/unusable"
      [[ "$config_dir_ok" == true ]] && ok "CONFIG_DIR" || warn "CONFIG_DIR missing/unusable"
      [[ "$mode_aligned" == true ]] && ok "FLIXBOX_MODE ↔ VPN_ENABLED" || warn "FLIXBOX_MODE ↔ VPN_ENABLED misaligned"
      [[ "$profile_ok" == true ]] && ok "Access profile (${profile})" || warn "Access profile invalid"
      log "API keys present: radarr=${radarr_key} sonarr=${sonarr_key} prowlarr=${prowlarr_key}"
      if [[ "$mode" == "vpn" ]]; then
        [[ "$gluetun" == "ok" ]] && ok "Gluetun (${gluetun})" || warn "Gluetun: ${gluetun}"
      else
        log "Gluetun: skipped (mode=${mode})"
      fi
    else
      warn ".env missing"
    fi
    if [[ -n "$hint" && "$hard_fail" -ne 0 ]]; then
      warn "Next: ${hint}"
    elif [[ "$hard_fail" -eq 0 ]]; then
      ok "Doctor: ready"
    fi
  fi

  if [[ "$docker_fail" -ne 0 ]]; then flixbox_exit_docker; fi
  if [[ "$config_fail" -ne 0 ]]; then flixbox_exit_config; fi
  if [[ "$deps_fail" -ne 0 ]]; then flixbox_exit_deps; fi
  return 0
}

usage() {
  cat <<EOF
Flixbox CLI

Usage:
  flixbox version
  flixbox doctor [--json]
  flixbox init [--force] [--non-interactive]
  flixbox up [plex|proxy|recyclarr]...
  flixbox down [--volumes]
  flixbox restart <service>
  flixbox reload [--reset-homepage] [plex|proxy|recyclarr]...
  flixbox homepage refresh [--dry-run]
  flixbox configure [--dry-run] [--verbose] [--sync-qbit-auth] [--sync-arr-ui]
  flixbox credentials show <target>
  flixbox credentials set  <target> --generate|--prompt
  flixbox status [--json] [-q|--quiet]
  flixbox logs [service] [-f]
  flixbox vpn-test

Global:
  -h, --help       Show this help
  --version        Same as version

Credentials targets: qbit | arr-ui | admin | api radarr|sonarr|prowlarr
  (arr-ui apply requires shared profile — ADR 0020)

Homepage: after git pull, up/reload/status warn if templates are newer than live config.
  Apply with: ./bin/flixbox homepage refresh  (or reload --reset-homepage)

Recyclarr sync (one-shot):
  docker compose --profile recyclarr run --rm recyclarr sync

Docs: docs/user/17-cli.md · ADR 0021
EOF
}

main() {
  local cmd="${1:-}"
  [[ -n "${cmd}" ]] || { usage; flixbox_exit_usage; }
  shift || true
  case "${cmd}" in
    version|--version) cmd_version "$@" ;;
    doctor) cmd_doctor "$@" ;;
    init) cmd_init "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    restart) cmd_restart "$@" ;;
    reload) cmd_reload "$@" ;;
    homepage) cmd_homepage "$@" ;;
    configure) cmd_configure "$@" ;;
    credentials) cmd_credentials "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    vpn-test) cmd_vpn_test "$@" ;;
    -h|--help|help) usage ;;
    *) die_usage "Unknown command: ${cmd} (try ./bin/flixbox --help)" ;;
  esac
}

main "$@"
