#!/usr/bin/env bash
# Flixbox CLI — day-0 / day-2 operations (MVP).
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/paths.sh"
# shellcheck disable=SC1091
source "${ROOT_DIR}/scripts/lib/access-profile.sh"

NO_COLOR="${NO_COLOR:-}"
if [[ -t 1 && -z "${NO_COLOR}" ]]; then
  C_INFO='\033[34m'
  C_OK='\033[32m'
  C_WARN='\033[33m'
  C_ERR='\033[31m'
  C_RST='\033[0m'
else
  C_INFO=''; C_OK=''; C_WARN=''; C_ERR=''; C_RST=''
fi

log() { printf '%b%s%b\n' "${C_INFO}" "$*" "${C_RST}"; }
ok() { printf '%b%s%b\n' "${C_OK}" "$*" "${C_RST}"; }
warn() { printf '%b%s%b\n' "${C_WARN}" "$*" "${C_RST}" >&2; }
die() { printf '%b%s%b\n' "${C_ERR}" "$*" "${C_RST}" >&2; exit 1; }

# BSD sed (macOS) requires '' after -i; GNU sed does not.
sed_inplace() {
  if [[ "$(uname -s)" == Darwin ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

load_env() {
  if [[ -f "${ROOT_DIR}/.env" ]]; then
    set -a
    # shellcheck disable=SC1090
    source <(grep -E '^[A-Z_][A-Z0-9_]*=' "${ROOT_DIR}/.env" | sed 's/\r$//')
    set +a
  fi
  DATA_DIR="${DATA_DIR:-$(flixbox_default_data_dir)}"
  CONFIG_DIR="${CONFIG_DIR:-$(flixbox_default_config_dir)}"
  PUID="${PUID:-1000}"
  PGID="${PGID:-1000}"
  FLIXBOX_MODE="${FLIXBOX_MODE:-direct}"
  VPN_ENABLED="${VPN_ENABLED:-false}"
}

compose() {
  docker compose --project-directory "${ROOT_DIR}" "$@"
}

warn_unsafe_paths() {
  local path="$1"
  if [[ "${path}" == /mnt/c/* || "${path}" == /mnt/d/* ]]; then
    warn "Warning: ${path} looks like a Windows/WSL NTFS mount — hardlinks may fail."
  fi
  if [[ "${path}" == *exfat* ]]; then
    warn "Warning: path mentions exfat — hardlinks are unsupported."
  fi
}

# Compose reads FLIXBOX_MODE only; VPN_ENABLED is a mirror. Return 0 if aligned.
mode_vpn_aligned() {
  local mode="${FLIXBOX_MODE:-direct}"
  local vpn="${VPN_ENABLED:-false}"
  if [[ "${mode}" == "vpn" ]]; then
    [[ "${vpn}" == "true" ]]
  else
    [[ "${vpn}" == "false" ]]
  fi
}

warn_mode_vpn_mismatch() {
  mode_vpn_aligned && return 0
  local mode="${FLIXBOX_MODE:-direct}"
  local vpn="${VPN_ENABLED:-false}"
  local expected="false"
  [[ "${mode}" == "vpn" ]] && expected="true"
  warn "FLIXBOX_MODE=${mode} and VPN_ENABLED=${vpn} disagree (expected VPN_ENABLED=${expected})."
  warn "Compose follows FLIXBOX_MODE only — VPN_ENABLED does not start or stop Gluetun."
  warn "Fix: set VPN_ENABLED=${expected} in .env, or run: ./bin/flixbox init --non-interactive"
  return 1
}

apply_platform_path_defaults() {
  apply_platform_env_defaults "${ROOT_DIR}/.env"
  if [[ "$(uname -s)" == Darwin ]]; then
    ok "Platform defaults in .env (paths under \$HOME/flixbox, PUID/PGID=$(id -u)/$(id -g))"
  else
    ok "Platform defaults in .env (DATA_DIR=$(flixbox_default_data_dir), CONFIG_DIR=$(flixbox_default_config_dir))"
  fi
}

# Servarr API keys (32 hex). Used by compose AUTH overrides + hygiene (ADR 0005).
generate_secret_hex() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 16
  else
    python3 -c 'import secrets; print(secrets.token_hex(16))'
  fi
}

generate_password() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 18 | tr -d '/+=' | head -c 20
  else
    python3 -c 'import secrets; print(secrets.token_urlsafe(16)[:20])'
  fi
}

# Write KEY=value into .env only when missing or empty (never overwrite set secrets).
env_set_if_empty() {
  local key="$1" value="$2" env_file="${ROOT_DIR}/.env"
  [[ -f "$env_file" ]] || return 0
  local current
  current=$(grep -E "^${key}=" "$env_file" 2>/dev/null | head -1 | cut -d= -f2- || true)
  [[ -n "$current" ]] && return 0
  if grep -q "^${key}=" "$env_file" 2>/dev/null; then
    sed_inplace "s|^${key}=.*|${key}=${value}|" "$env_file"
  else
    printf '\n%s=%s\n' "$key" "$value" >> "$env_file"
  fi
  ok "Generated ${key} in .env (was empty)"
}

ensure_first_run_secrets() {
  local key
  for key in RADARR_API_KEY SONARR_API_KEY PROWLARR_API_KEY; do
    env_set_if_empty "$key" "$(generate_secret_hex)"
  done
  env_set_if_empty QBITTORRENT_USERNAME admin
  env_set_if_empty QBITTORRENT_PASSWORD "$(generate_password)"
  # Optional shared admin for Jellyfin/Seerr automation (configure)
  env_set_if_empty FLIXBOX_ADMIN_USER admin
  env_set_if_empty FLIXBOX_ADMIN_PASSWORD "$(generate_password)"
  if [[ "$(flixbox_access_profile)" == "shared" ]]; then
    env_set_if_empty FLIXBOX_ARR_UI_USER admin
    env_set_if_empty FLIXBOX_ARR_UI_PASSWORD "$(generate_password)"
  fi
}

copy_templates() {
  mkdir -p \
    "${CONFIG_DIR}/recyclarr" \
    "${CONFIG_DIR}/homepage" \
    "${CONFIG_DIR}/caddy" \
    "${CONFIG_DIR}/maintainerr" \
    "${CONFIG_DIR}/gluetun" \
    "${CONFIG_DIR}/qbittorrent" \
    "${CONFIG_DIR}/prowlarr" \
    "${CONFIG_DIR}/radarr" \
    "${CONFIG_DIR}/sonarr" \
    "${CONFIG_DIR}/bazarr" \
    "${CONFIG_DIR}/jellyfin" \
    "${CONFIG_DIR}/seerr" \
    "${CONFIG_DIR}/unpackerr"

  [[ -f "${CONFIG_DIR}/recyclarr/recyclarr.yml" ]] || \
    cp "${ROOT_DIR}/templates/recyclarr/recyclarr.yml" "${CONFIG_DIR}/recyclarr/recyclarr.yml"
  [[ -f "${CONFIG_DIR}/homepage/services.yaml" ]] || \
    cp "${ROOT_DIR}/templates/homepage/services.yaml" "${CONFIG_DIR}/homepage/services.yaml"
  [[ -f "${CONFIG_DIR}/homepage/settings.yaml" ]] || \
    cp "${ROOT_DIR}/templates/homepage/settings.yaml" "${CONFIG_DIR}/homepage/settings.yaml"
  [[ -f "${CONFIG_DIR}/homepage/widgets.yaml" ]] || \
    cp "${ROOT_DIR}/templates/homepage/widgets.yaml" "${CONFIG_DIR}/homepage/widgets.yaml"
  [[ -f "${CONFIG_DIR}/homepage/docker.yaml" ]] || \
    cp "${ROOT_DIR}/templates/homepage/docker.yaml" "${CONFIG_DIR}/homepage/docker.yaml"
  [[ -f "${CONFIG_DIR}/caddy/Caddyfile" ]] || \
    cp "${ROOT_DIR}/templates/caddy/Caddyfile" "${CONFIG_DIR}/caddy/Caddyfile"
  [[ -f "${CONFIG_DIR}/maintainerr/README.md" ]] || \
    cp "${ROOT_DIR}/templates/maintainerr/README.md" "${CONFIG_DIR}/maintainerr/README.md"
  # linuxserver runs /custom-cont-init.d (separate mount), not /config/custom-cont-init.d
  mkdir -p "${CONFIG_DIR}/qbittorrent-cont-init" \
    "${CONFIG_DIR}/qbittorrent-custom-services"
  cp -f "${ROOT_DIR}/templates/qbittorrent/custom-cont-init.d/99-flixbox-qbittorrent.sh" \
    "${CONFIG_DIR}/qbittorrent-cont-init/99-flixbox-qbittorrent.sh"
  chmod +x "${CONFIG_DIR}/qbittorrent-cont-init/99-flixbox-qbittorrent.sh"
  cp -f "${ROOT_DIR}/templates/qbittorrent/custom-services.d/99-flixbox-bind-vpn-interface.sh" \
    "${CONFIG_DIR}/qbittorrent-custom-services/99-flixbox-bind-vpn-interface.sh"
  chmod +x "${CONFIG_DIR}/qbittorrent-custom-services/99-flixbox-bind-vpn-interface.sh"
  # Decluttarr idle-gate entrypoint (runtime env; not Compose-interpolated command)
  cp -f "${ROOT_DIR}/templates/decluttarr/entrypoint.sh" \
    "${CONFIG_DIR}/decluttarr-entrypoint.sh"
  chmod +x "${CONFIG_DIR}/decluttarr-entrypoint.sh"
  # Remove legacy location (ignored by current linuxserver images)
  rm -f "${CONFIG_DIR}/qbittorrent/custom-cont-init.d/99-flixbox-qbittorrent.sh" \
    "${CONFIG_DIR}/qbittorrent/custom-cont-init.d/99-flixbox-webui.sh"
  rmdir "${CONFIG_DIR}/qbittorrent/custom-cont-init.d" 2>/dev/null || true
}

cmd_init() {
  load_env
  local force=0 non_interactive=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --non-interactive) non_interactive=1; shift ;;
      *) die "Unknown init option: $1" ;;
    esac
  done

  if [[ -f "${ROOT_DIR}/.env" && "${force}" -ne 1 ]]; then
    warn ".env already exists (use --force to overwrite from .env.example)."
  else
    cp -f "${ROOT_DIR}/.env.example" "${ROOT_DIR}/.env"
    ok "Wrote .env from .env.example"
    apply_platform_path_defaults
  fi

  if [[ "${non_interactive}" -eq 0 ]]; then
    log "Edit .env now if needed (DATA_DIR, CONFIG_DIR, FLIXBOX_MODE, VPN_*)."
    log "Press Enter to continue with bootstrap dirs..."
    read -r _
  fi

  load_env
  warn_unsafe_paths "${DATA_DIR}"
  warn_unsafe_paths "${CONFIG_DIR}"

  if ! mode_vpn_aligned; then
    warn_mode_vpn_mismatch || true
    warn "Syncing VPN_ENABLED from FLIXBOX_MODE=${FLIXBOX_MODE}..."
  fi
  if [[ "${FLIXBOX_MODE}" == "vpn" ]]; then
    sed_inplace 's/^VPN_ENABLED=.*/VPN_ENABLED=true/' "${ROOT_DIR}/.env" || true
  else
    sed_inplace 's/^VPN_ENABLED=.*/VPN_ENABLED=false/' "${ROOT_DIR}/.env" || true
  fi
  load_env
  ok "VPN_ENABLED=${VPN_ENABLED} (aligned with FLIXBOX_MODE=${FLIXBOX_MODE})"

  # Decluttarr qBit URL — same host in VPN and Direct (ADR 0014: alias on Gluetun in VPN mode)
  if grep -q '^DECLUTTARR_QBIT_URL=' "${ROOT_DIR}/.env"; then
    sed_inplace 's|^DECLUTTARR_QBIT_URL=.*|DECLUTTARR_QBIT_URL=http://qbittorrent:8080|' "${ROOT_DIR}/.env"
  else
    printf '\nDECLUTTARR_QBIT_URL=http://qbittorrent:8080\n' >> "${ROOT_DIR}/.env"
  fi

  validate_flixbox_paths "${DATA_DIR}" "${CONFIG_DIR}" || \
    die "Path validation failed. Fix DATA_DIR and CONFIG_DIR in .env, then re-run init."

  "${ROOT_DIR}/scripts/bootstrap-dirs.sh"
  load_env
  copy_templates
  flixbox_validate_access_profile || die "Fix FLIXBOX_ACCESS_PROFILE in .env (trusted or shared)."
  flixbox_sync_access_profile_env "${ROOT_DIR}/.env"
  ensure_first_run_secrets
  load_env
  chown -R "${PUID}:${PGID}" "${CONFIG_DIR}" 2>/dev/null || warn "Could not chown CONFIG_DIR (may need sudo)."
  ok "Init complete."
  log "Access profile: $(flixbox_access_profile) (*arr UI auth — ADR 0015)"
  if [[ "$(flixbox_access_profile)" == "shared" ]]; then
    log "shared: *arr WebUI login uses FLIXBOX_ARR_UI_USER/PASSWORD; configure still uses API keys."
  fi
  log "Review .env before first up: DATA_DIR, CONFIG_DIR, FLIXBOX_MODE (Gluetun vars if vpn)."
  log "API keys + qBit/Jellyfin admin passwords were generated if empty — keep .env private."
  log "After up: ./bin/flixbox configure  (idempotent wiring; indexers stay manual)"
  log "Reference: docs/user/REFERENCE.md · First-run: docs/user/05-first-run.md"
}

cmd_up() {
  load_env
  local profiles=()
  parse_profiles profiles "$@"
  require_flixbox_dirs "${DATA_DIR}" "${CONFIG_DIR}" || \
    die "Directories missing. Run ./bin/flixbox init after fixing paths in .env."
  if [[ -z "${QBITTORRENT_PASSWORD:-}" || -z "${QBITTORRENT_USERNAME:-}" ]]; then
    warn "QBITTORRENT_USERNAME/PASSWORD incomplete — Decluttarr stays idle until both are set in .env and Decluttarr is recreated."
  fi
  warn_mode_vpn_mismatch || true
  log "Starting Flixbox (FLIXBOX_MODE=${FLIXBOX_MODE})..."
  compose "${profiles[@]}" up -d
  ok "Stack started. ./bin/flixbox status"
  log "Next: ./bin/flixbox configure  (then add Prowlarr indexers)"
  log "Guide: docs/user/05-first-run.md · Cheat sheet: docs/user/REFERENCE.md"
}

parse_profiles() {
  local -n _out=$1
  shift
  _out=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        _out+=(--profile "$2")
        shift 2
        ;;
      plex|proxy|socket-proxy|recyclarr)
        _out+=(--profile "$1")
        shift
        ;;
      *)
        die "Unknown profile argument: $1 (try plex|proxy|socket-proxy|recyclarr or --profile NAME)"
        ;;
    esac
  done
}

cmd_down() {
  load_env
  compose down "$@"
  ok "Stack stopped."
}

cmd_restart() {
  load_env
  local svc="${1:-}"
  [[ -n "${svc}" ]] || die "Usage: flixbox restart <service>"
  compose restart "${svc}"
}

cmd_reload() {
  load_env
  local profiles=()
  parse_profiles profiles "$@"
  require_flixbox_dirs "${DATA_DIR}" "${CONFIG_DIR}" || \
    die "Directories missing. Run ./bin/flixbox init first."
  warn_mode_vpn_mismatch || true
  log "Recreating containers (applies .env and compose changes)..."
  log "Tip: prefer reload over down when you only changed config."
  compose "${profiles[@]}" up -d --force-recreate
  ok "Stack reloaded. ./bin/flixbox status"
}

cmd_configure() {
  load_env
  exec "${ROOT_DIR}/scripts/configure-apps.sh" "$@"
}

cmd_status() {
  load_env
  compose ps
  echo
  log "FLIXBOX_MODE=${FLIXBOX_MODE}  VPN_ENABLED=${VPN_ENABLED}"
  warn_mode_vpn_mismatch || true
  log "DATA_DIR=${DATA_DIR}"
  log "CONFIG_DIR=${CONFIG_DIR}"
  log "Download client URL for *arr / Decluttarr: http://qbittorrent:8080 (same in VPN and Direct — ADR 0014)"
}

cmd_logs() {
  load_env
  if [[ $# -eq 0 ]]; then
    compose logs --tail=100 -f
  else
    compose logs --tail=100 "$@"
  fi
}

cmd_vpn_test() {
  load_env
  exec "${ROOT_DIR}/scripts/vpn-test.sh"
}

usage() {
  cat <<EOF
Flixbox CLI

Usage:
  flixbox init [--force] [--non-interactive]
  flixbox up [plex|proxy|socket-proxy|recyclarr]...
  flixbox down [--volumes]
  flixbox restart <service>
  flixbox reload [plex|proxy|socket-proxy|recyclarr]...
  flixbox configure [--dry-run] [--verbose]
  flixbox status
  flixbox logs [service] [-f]
  flixbox vpn-test

Recyclarr sync (one-shot):
  docker compose --profile recyclarr run --rm recyclarr sync

EOF
}

main() {
  local cmd="${1:-}"
  [[ -n "${cmd}" ]] || { usage; exit 1; }
  shift || true
  case "${cmd}" in
    init) cmd_init "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    restart) cmd_restart "$@" ;;
    reload) cmd_reload "$@" ;;
    configure) cmd_configure "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    vpn-test) cmd_vpn_test "$@" ;;
    -h|--help|help) usage ;;
    *) die "Unknown command: ${cmd}" ;;
  esac
}

main "$@"
